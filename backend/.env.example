# Application
APP_ENV=development

# ──────────────────────────────────────────────────────────────────────────────
# Provider API Keys  (all 3 providers are 100% free — no credit card)
# ──────────────────────────────────────────────────────────────────────────────

# Mistral AI — https://console.mistral.ai
# Free tier: rate-limited on the free plan
# Signup: email only
MISTRAL_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day · 1M tokens/min (gemini-2.0-flash)
# Signup: Google account, click "Get API key"
GEMINI_API_KEY=

# OpenRouter — https://openrouter.ai/settings/keys
# Free tier: models ending in ":free" have no cost at all
# Signup: email only
OPENROUTER_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Provider Models — change these to swap models without touching code
# ──────────────────────────────────────────────────────────────────────────────
MISTRAL_MODEL=mistral-small-latest
GEMINI_MODEL=gemini-3.1-flash-lite
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ──────────────────────────────────────────────────────────────────────────────
# Provider Base URLs — only change if the provider migrates their endpoint
# ──────────────────────────────────────────────────────────────────────────────
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ──────────────────────────────────────────────────────────────────────────────
# Performance
# ──────────────────────────────────────────────────────────────────────────────
LLM_TIMEOUT=30

# ──────────────────────────────────────────────────────────────────────────────
# File Upload
# ──────────────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ──────────────────────────────────────────────────────────────────────────────
# Rate Limiting (protects your free-tier quotas)
# ──────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
